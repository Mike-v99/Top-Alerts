# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # never expose on client

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Price APIs ────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your-finnhub-key             # stocks (free: 60 req/min)
TWELVE_DATA_API_KEY=your-twelve-data-key     # crypto + stocks (free: 800 req/day)

# ── Delivery ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key            # email (free: 3k/mo)
ONESIGNAL_APP_ID=your-onesignal-app-id       # push (free)
ONESIGNAL_API_KEY=your-onesignal-api-key
TWILIO_ACCOUNT_SID=your-twilio-sid           # SMS — Pro plan only
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRO_PRICE_ID=price_your-pro-id
STRIPE_TEAM_PRICE_ID=price_your-team-id

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
ENGINE_POLL_INTERVAL_MS=30000               # how often the engine checks prices
PRICE_CACHE_TTL_SECONDS=60                  # Redis TTL for price data
NODE_ENV=development
